# --- AI (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Database ---
# Default is a local SQLite file (no setup). To use PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/skilltracker
# DATABASE_URL=sqlite:///data/skilltracker.db

# --- Accounts ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123      # CHANGE THIS for any real use
DEMO_PASSWORD=Demo@123        # password given to users imported from the sample dataset

# --- First-run sample data (1 = load example users/interviews if DB is empty) ---
AUTO_LOAD_SAMPLE=1
SHOW_DEMO_HINT=1              # show demo credentials on the login page

# --- Avatar video interview & recordings ---
# STORAGE_DIR=storage/recordings   # where audio/video answers are saved (admin can review them)
AVATAR_NAME=Aria
MAX_ANSWER_SECONDS=120
SILENCE_SECONDS=3.5

# --- Proctoring: leaving the interview tab/window counts as a violation ---
PROCTORING_ENABLED=1
MAX_VIOLATIONS=3
